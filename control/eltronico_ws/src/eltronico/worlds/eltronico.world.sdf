          <pose>1.34 0 0.4455 0 0 0</pose>
          <geometry><box><size>0.298 1.95 0.891</size></box></geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
        <!-- Peldaño 6: x=1.489..1.787 m, altura=1.068 m -->
        <collision name="peldaño_6_collision">
          <pose>1.638 0 0.534 0 0 0</pose>
          <geometry><box><size>0.298 1.95 1.068</size></box></geometry>
        </collision>
        <visual name="peldaño_6_visual">
          <pose>1.638 0 0.534 0 0 0</pose>
          <geometry><box><size>0.298 1.95 1.068</size></box></geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
        <!-- Peldaño 7: x=1.787..2.085 m, altura=1.245 m -->
        <collision name="peldaño_7_collision">
          <pose>1.936 0 0.6225 0 0 0</pose>
          <geometry><box><size>0.298 1.95 1.245</size></box></geometry>
        </collision>
        <visual name="peldaño_7_visual">
          <pose>1.936 0 0.6225 0 0 0</pose>
          <geometry><box><size>0.298 1.95 1.245</size></box></geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
        <!-- Peldaño 8: x=2.085..2.384 m, altura=1.422 m -->
        <collision name="peldaño_8_collision">
