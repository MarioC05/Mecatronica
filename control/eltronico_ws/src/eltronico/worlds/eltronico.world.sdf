          <pose>2.2345 0 0.711 0 0 0</pose>
          <geometry><box><size>0.299 1.95 1.422</size></box></geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
        <!-- Peldaño 9: x=2.384..2.682 m, altura=1.599 m -->
        <collision name="peldaño_9_collision">
          <pose>2.533 0 0.7995 0 0 0</pose>
          <geometry><box><size>0.298 1.95 1.599</size></box></geometry>
        </collision>
