          <pose>2.533 0 0.7995 0 0 0</pose>
          <geometry><box><size>0.298 1.95 1.599</size></box></geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
        <!-- Peldaño 10: x=2.682..2.981 m, altura=1.78 m -->
        <collision name="peldaño_10_collision">
          <pose>2.8315 0 0.89 0 0 0</pose>
          <geometry><box><size>0.299 1.95 1.78</size></box></geometry>
        </collision>
        <visual name="peldaño_10_visual">
          <pose>2.8315 0 0.89 0 0 0</pose>
          <geometry><box><size>0.299 1.95 1.78</size></box></geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
        <!-- Peldaño 11: x=2.981..3.28 m, altura=1.958 m -->
        <collision name="peldaño_11_collision">
          <pose>3.1305 0 0.979 0 0 0</pose>
          <geometry><box><size>0.299 1.95 1.958</size></box></geometry>
        </collision>
        <visual name="peldaño_11_visual">
          <pose>3.1305 0 0.979 0 0 0</pose>
          <geometry><box><size>0.299 1.95 1.958</size></box></geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
