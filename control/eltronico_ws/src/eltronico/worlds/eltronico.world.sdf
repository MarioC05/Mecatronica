<?xml version="1.0"?>
<sdf version="1.9">
  <world name="eltronico_world">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Necesario para los sensores de contacto de las dos ruedas del torso. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.85 0.88 0.92 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Escalera generada a partir de escaleras.csv. -->
    <!-- El primer frente está en x=1 m y la subida avanza hacia +X. -->
    <!-- Las cajas reproducen huellas, alturas y ancho; no modelan el chaflán de 10 mm. -->
    <model name="escaleras">
      <static>true</static>
      <pose>1 0 0 0 0 0</pose>
      <link name="estructura">
        <!-- Peldaño 1: x=0..0.299 m, altura=0.179 m -->
        <collision name="peldaño_1_collision">
          <pose>0.1495 0 0.0895 0 0 0</pose>
          <geometry><box><size>0.299 1.95 0.179</size></box></geometry>
        </collision>
        <visual name="peldaño_1_visual">
          <pose>0.1495 0 0.0895 0 0 0</pose>
          <geometry><box><size>0.299 1.95 0.179</size></box></geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
        <!-- Peldaño 2: x=0.299..0.597 m, altura=0.357 m -->
        <collision name="peldaño_2_collision">
          <pose>0.448 0 0.1785 0 0 0</pose>
          <geometry><box><size>0.298 1.95 0.357</size></box></geometry>
        </collision>
        <visual name="peldaño_2_visual">
          <pose>0.448 0 0.1785 0 0 0</pose>
          <geometry><box><size>0.298 1.95 0.357</size></box></geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
        <!-- Peldaño 3: x=0.597..0.894 m, altura=0.535 m -->
        <collision name="peldaño_3_collision">
          <pose>0.7455 0 0.2675 0 0 0</pose>
          <geometry><box><size>0.297 1.95 0.535</size></box></geometry>
        </collision>
        <visual name="peldaño_3_visual">
          <pose>0.7455 0 0.2675 0 0 0</pose>
          <geometry><box><size>0.297 1.95 0.535</size></box></geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
        <!-- Peldaño 4: x=0.894..1.191 m, altura=0.713 m -->
        <collision name="peldaño_4_collision">
          <pose>1.0425 0 0.3565 0 0 0</pose>
          <geometry><box><size>0.297 1.95 0.713</size></box></geometry>
        </collision>
