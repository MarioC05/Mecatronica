        </visual>
        <!-- Peldaño 5: x=1.191..1.489 m, altura=0.891 m -->
        <collision name="peldaño_5_collision">
          <pose>1.34 0 0.4455 0 0 0</pose>
          <geometry><box><size>0.298 1.95 0.891</size></box></geometry>
        </collision>
