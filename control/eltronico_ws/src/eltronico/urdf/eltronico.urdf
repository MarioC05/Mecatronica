  <link name="caster_left">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="2e-06" ixy="0" ixz="0" iyy="2e-06" iyz="0" izz="2e-06" />
    </inertial>
    <collision name="pololu_951_ball_proxy">
      <origin xyz="0 0 0" />
      <geometry>
        <sphere radius="0.0047625" />
      </geometry>
    </collision>
    <visual name="bola_0">
      <origin xyz="-0.112000000 0.027000000 -0.193250000" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://eltronico/meshes/cad_actual/bola_0.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="bola_0_color">
        <color rgba=".2 .25 .3 1" />
      </material>
    </visual>
  </link>
  <link name="caster_right">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="2e-06" ixy="0" ixz="0" iyy="2e-06" iyz="0" izz="2e-06" />
    </inertial>
    <collision name="pololu_951_ball_proxy">
      <origin xyz="0 0 0" />
      <geometry>
        <sphere radius="0.0047625" />
      </geometry>
    </collision>
    <visual name="bola_1">
      <origin xyz="-0.112000000 -0.027000000 -0.193250000" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://eltronico/meshes/cad_actual/bola_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="bola_1_color">
        <color rgba=".2 .25 .3 1" />
      </material>
    </visual>
  </link>
  <link name="pi_collision_guard">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.002" />
      <inertia ixx="2e-06" ixy="0" ixz="0" iyy="2e-06" iyz="0" izz="2e-06" />
    </inertial>
    <collision name="raspberry_pi4_collision_proxy">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.088 0.057 0.018" />
      </geometry>
    </collision>
  </link>
  <joint name="pi_collision_guard_fixed" type="fixed">
    <parent link="base" />
    <child link="pi_collision_guard" />
    <origin xyz="-.0575 -.00125 .2295" rpy="0 0 0" />
  </joint>
  <joint name="hip_left" type="continuous">
    <parent link="base" />
    <child link="thigh_left" />
    <origin xyz="-0.005000 -0.045000 0.214000" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit effort="2.0" velocity="2.0" />
  </joint>
  <joint name="hip_right" type="continuous">
    <parent link="base" />
    <child link="thigh_right" />
    <origin xyz="-0.005000 0.045000 0.214000" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit effort="2.0" velocity="2.0" />
  </joint>
  <joint name="knee_left" type="continuous">
    <parent link="thigh_left" />
    <child link="shin_left" />
    <origin xyz="0.000000 -0.033000 -0.072365" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit effort="1.5" velocity="2.0" />
  </joint>
  <joint name="knee_right" type="continuous">
    <parent link="thigh_right" />
    <child link="shin_right" />
    <origin xyz="0.000000 0.033000 -0.072365" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit effort="1.5" velocity="2.0" />
  </joint>
  <joint name="front_pitch" type="revolute">
    <parent link="base" />
    <child link="front_leg" />
    <origin xyz="0.090 0 0.199" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="1.5707963267948966" effort="0.18" velocity="0.8" />
  </joint>
  <joint name="motor_hip_left_joint" type="continuous">
    <!-- Relacion geometrica motor/salida 3:1; pendiente validar sentido y dinamica en Gazebo. -->
    <mimic joint="hip_left" multiplier="3.0" offset="0.0" />
    <parent link="base" />
    <child link="motor_hip_left" />
    <origin xyz="0.019000 -0.049650 0.214000" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="0.2157" velocity="12.56" />
  </joint>
  <joint name="motor_hip_right_joint" type="continuous">
    <!-- Relacion geometrica motor/salida 3:1; pendiente validar sentido y dinamica en Gazebo. -->
    <mimic joint="hip_right" multiplier="3.0" offset="0.0" />
    <parent link="base" />
    <child link="motor_hip_right" />
    <origin xyz="0.019000 0.049650 0.214000" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="0.2157" velocity="12.56" />
  </joint>
  <joint name="motor_knee_left_joint" type="continuous">
    <!-- Relacion geometrica motor/salida 3:1; pendiente validar sentido y dinamica en Gazebo. -->
    <mimic joint="knee_left" multiplier="3.0" offset="0.0" />
    <parent link="thigh_left" />
    <child link="motor_knee_left" />
    <origin xyz="-0.024608934 -0.059200000 -0.072365000" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="0.2157" velocity="12.56" />
  </joint>
  <joint name="motor_knee_right_joint" type="continuous">
    <!-- Relacion geometrica motor/salida 3:1; pendiente validar sentido y dinamica en Gazebo. -->
    <mimic joint="knee_right" multiplier="3.0" offset="0.0" />
    <parent link="thigh_right" />
    <child link="motor_knee_right" />
    <origin xyz="-0.024608934 0.059200000 -0.072365000" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="0.2157" velocity="12.56" />
  </joint>
  <joint name="caster_left_roll" type="continuous">
    <parent link="base" />
    <child link="caster_left" />
    <origin xyz=".112 -0.027 .19325" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="0.02" velocity="30" />
  </joint>
  <joint name="caster_right_roll" type="continuous">
    <parent link="base" />
    <child link="caster_right" />
    <origin xyz=".112 0.027 .19325" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="0.02" velocity="30" />
  </joint>

  <!-- Interfaces de ros2_control para Gazebo Harmonic.
       Se mandan consignas a las 5 articulaciones de salida.
       Los 4 ejes de motor son imitadores 3:1, solo para observar su estado. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="hip_left">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="knee_left">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="hip_right">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="knee_right">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="front_pitch">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="motor_hip_left_joint">
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="motor_knee_left_joint">
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="motor_hip_right_joint">
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="motor_knee_right_joint">
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <!-- El launch resuelve esta ruta a un archivo absoluto al iniciar Gazebo. -->
      <parameters>$(find eltronico)/config/controllers.yaml</parameters>
      <controller_manager_name>controller_manager</controller_manager_name>
      <hold_joints>true</hold_joints>
      <!-- Ganancia del seguimiento de posiciones (valor anterior por defecto: 0.1).
           Se usa 0.5 para ensayos; verificar estabilidad y velocidad real. -->
      <position_proportional_gain>0.5</position_proportional_gain>
    </plugin>
  </gazebo>


  <!-- Odometría 3D de simulación para roll, pitch, yaw y posición del torso.
       No sustituye a la IMU MPU6050 del robot físico. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/eltronico/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <!-- Contactos de ruedas con escalones. Los nombres de colisión se toman
       de los elementos originales de cada link del URDF. -->
  <gazebo reference="caster_left">
    <sensor name="caster_left_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/eltronico/caster_left/contacts</topic>
      <contact><collision>pololu_951_ball_proxy</collision></contact>
    </sensor>
  </gazebo>
  <gazebo reference="caster_right">
    <sensor name="caster_right_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/eltronico/caster_right/contacts</topic>
      <contact><collision>pololu_951_ball_proxy</collision></contact>
    </sensor>
  </gazebo>
</robot>